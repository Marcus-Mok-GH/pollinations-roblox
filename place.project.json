{
    "name": "PollenVillage",
    "tree": {
        "$className": "DataModel",
        "HttpService": {
            "$properties": {
                "HttpEnabled": true
            }
        },
        "TextChatService": {
            "$properties": {
                "ChatVersion": "TextChatService"
            }
        },
        "ReplicatedStorage": {
            "$className": "ReplicatedStorage",
            "PollinationsRoblox": {
                "$path": "src"
            }
        },
        "ServerScriptService": {
            "$className": "ServerScriptService",
            "PollenVillage": {
                "$path": "example/PollenVillage.server.luau"
            }
        },
        "StarterPlayer": {
            "$className": "StarterPlayer",
            "StarterPlayerScripts": {
                "$className": "StarterPlayerScripts",
